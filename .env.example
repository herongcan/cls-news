# 复制成 .env 后填写，然后 chmod 600 .env
# 这个文件里有密码和 key，不要提交到 git（.gitignore 已排除）

# ---------- 访问控制 ----------
# 放到公网必须 true。false 时任何知道地址的人都能看到转贴全文。
APP_AUTH=true
APP_USER=admin
# 别用 123456。生成一个：openssl rand -base64 18
# 注意 Basic 认证的密码是 Base64 传输，等同明文，公网一定要配 HTTPS
APP_PASSWORD=

# ---------- 大模型 ----------
# 从 https://platform.deepseek.com 的 API keys 页面取
DEEPSEEK_API_KEY=

# ---------- 运行参数（可选） ----------
# 抓取间隔毫秒，默认 90 秒。低于 30 秒对财联社不礼貌，也更容易被风控
INGEST_INTERVAL_MS=90000
